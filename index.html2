<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>JonahSliman.github.io</title>
<style>
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:#020817;color:white;font-family:Arial,Helvetica,sans-serif}
.hero{height:100vh;min-height:650px;display:flex;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;background:radial-gradient(circle at 50% 25%,#0759a8,#031b3b 48%,#010611 100%)}
.hero:before{content:"";position:absolute;width:900px;height:900px;background:radial-gradient(circle,#00bfff33,transparent 65%);top:-400px;left:50%;transform:translateX(-50%)}
nav{position:absolute;top:0;left:0;right:0;padding:24px 5%;display:flex;justify-content:space-between;z-index:2;background:linear-gradient(#0008,transparent)}
.logo{font-size:22px;font-weight:900;text-shadow:0 0 18px #00bfff}
nav a{color:#fff;text-decoration:none;margin-left:10px;padding:10px 16px;border:1px solid #ffffff55;border-radius:999px;background:#0004}
.content{position:relative;z-index:1}
h1{font-size:clamp(48px,9vw,120px);margin:0;font-weight:1000;letter-spacing:-5px;background:linear-gradient(#fff,#8eeaff,#168fff);-webkit-background-clip:text;color:transparent;text-shadow:0 0 40px #00bfff}
.content p{font-size:20px;max-width:650px;margin:25px auto;color:#eef8ff}
.btn{display:inline-block;color:white;text-decoration:none;background:#087dff;border:1px solid #8eeaff;padding:15px 24px;border-radius:14px;font-weight:900;box-shadow:0 0 30px #008cff77}
.showcase{padding:100px 4%;background:#020817}
.imagebox{max-width:1500px;margin:auto;border-radius:28px;overflow:hidden;border:1px solid #5bd5ff66;box-shadow:0 30px 90px #000}
.imagebox img{width:100%;display:block}
.caption{padding:35px;text-align:center;background:#020817}
.caption h2{font-size:clamp(32px,5vw,65px);margin:0 0 10px}
.projects{padding:100px 5%;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:1100px;margin:auto}
.card{padding:28px;border-radius:22px;background:#07182d;border:1px solid #5bbcff33}
.card p{color:#b8c9d8;line-height:1.6}
footer{padding:35px;text-align:center;color:#8297aa;background:#010611}
@media(max-width:750px){nav .links{display:none}.projects{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="hero">
<nav><div class="logo">JonahSliman.github.io</div><div class="links"><a href="#showcase">Showcase</a><a href="#projects">Projects</a></div></nav>
<div class="content">
<h1>JonahSliman.github.io</h1>
<p>Welcome to my corner of the internet — games, projects, creations, and whatever I build next.</p>
<a class="btn" href="#showcase">Scroll Down ✈️</a>
</div>
</div>

<section class="showcase" id="showcase">
<div class="imagebox">
<img src="data:image/png;base64," alt="JonahSliman.github.io airplane banner">
<div class="caption"><h2>Ready for takeoff.</h2></div>
</div>
</section>

<section class="projects" id="projects">
<div class="card"><h2>🎮 Games</h2><p>Show off your Roblox games and creations.</p></div>
<div class="card"><h2>🚀 Projects</h2><p>Add websites, experiments, videos, and other projects.</p></div>
<div class="card"><h2>✈️ More Coming</h2><p>Keep building and add whatever you want here.</p></div>
</section>
<footer>© 2026 JonahSliman.github.io</footer>
</body>
</html>
